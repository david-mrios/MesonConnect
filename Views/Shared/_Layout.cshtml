<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MensonConnect</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&family=Inter&family=Amatic+SC&display=swap" rel="stylesheet">

    <!-- Vendor CSS -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS -->
    <link href="~/assets/css/main.css" rel="stylesheet">

    <!-- Vendor Styles -->
    @RenderSection("VendorStyles", required: false)

    <!-- Page Styles -->
    @RenderSection("PageStyles", required: false)

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>



<body class="@ViewData["BodyClass"]">

    @await Html.PartialAsync("_Header")

    @RenderBody()

    @await Html.PartialAsync("_Footer")

    <!-- JS -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <script src="~/assets/js/main.js"></script>

    <!-- Vendor Scripts -->
    @RenderSection("VendorScripts", required: false)

    <!-- Page Scripts -->
    @RenderSection("PageScripts", required: false)

    @{
        var controller = Context.Request.RouteValues["controller"]?.ToString();
        var action = Context.Request.RouteValues["action"]?.ToString();
    }

    @if (!(string.Equals(controller, "Auth", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Login", StringComparison.OrdinalIgnoreCase)))
    {
        <!-- 🛒 BOTÓN -->
        <button id="cartToggle" class="cart-float-btn">
            🛒 <span id="cartCount">0</span>
        </button>

        <!-- 🛒 SIDEBAR -->
        <div id="cartSidebar" class="cart-sidebar">

            <div class="cart-header">
                <h4>🛒 Tu Pedido</h4>
                <button class="close-cart" onclick="toggleCart()">✖</button>
            </div>

            <ul id="cartItems"></ul>

            <hr>

            <h5>Total: $<span id="cartTotal">0.00</span></h5>

            <button class="btn btn-success w-100 mt-2"
                    onclick="realizarPedido()">
                Realizar Pedido
            </button>

        </div>
    }

    <script>

        let cart = [];

        function toggleCart() {
            document.getElementById("cartSidebar").classList.toggle("active");
        }

        function updateCart() {

            let list = document.getElementById("cartItems");
            let total = 0;

            list.innerHTML = "";

            cart.forEach(item => {

                total += item.price * item.cantidad;

                list.innerHTML += `
                    <li>
                        ${item.name} - C$${item.price.toFixed(2)}

                        <button type="button"
                                onclick="removeItem(${item.cartId})">
                            🗑
                        </button>
                    </li>
                `;
            });

            document.getElementById("cartTotal").innerText =
                total.toFixed(2);

            document.getElementById("cartCount").innerText =
                cart.length;
        }

        function removeItem(id) {

            cart = cart.filter(x => x.cartId !== id);

            updateCart();

            Swal.fire({
                icon: 'success',
                title: 'Producto eliminado',
                timer: 1200,
                showConfirmButton: false
            });
        }

        window.removeItem = removeItem;

        document.addEventListener("click", function (e) {

            if (e.target.classList.contains("add-to-cart")) {

                let item = {
                    cartId: Date.now(),
                    platilloId: parseInt(e.target.dataset.id),
                    name: e.target.dataset.name,
                    price: parseFloat(e.target.dataset.price),
                    cantidad: 1
                };

                cart.push(item);

                updateCart();

                document
                    .getElementById("cartSidebar")
                    .classList.add("active");

                Swal.fire({
                    icon: 'success',
                    title: 'Agregado al carrito',
                    text: item.name,
                    timer: 1500,
                    showConfirmButton: false
                });
            }
        });

        window.realizarPedido = async function () {

            if (cart.length === 0) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Carrito vacío',
                    text: 'Agrega al menos un producto'
                });

                return;
            }

            try {

                Swal.fire({
                    title: 'Procesando pedido...',
                    text: 'Por favor espera',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch('/Home/CrearPedido', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(cart)
                });

                const data = await response.json();

                Swal.close();

                if (data.noLogin) {

                    Swal.fire({
                        icon: 'info',
                        title: 'Inicia sesión',
                        text: 'Debes iniciar sesión para realizar pedidos'
                    }).then(() => {
                        window.location.href = "/Auth/Login";
                    });

                    return;
                }

                if (data.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Pedido realizado',
                        text: 'Tu pedido fue registrado correctamente',
                        confirmButtonColor: '#ce1212'
                    });

                    cart = [];

                    updateCart();

                    document
                        .getElementById("cartSidebar")
                        .classList.remove("active");

                    return;
                }

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'No se pudo realizar el pedido'
                });

            }
            catch (error) {

                console.error(error);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Ocurrió un problema al enviar el pedido'
                });
            }
        };

        const cartBtn = document.getElementById("cartToggle");

        if (cartBtn) {

            cartBtn.addEventListener("click", function () {

                toggleCart();

            });
        }

    </script>

</body>
</html>