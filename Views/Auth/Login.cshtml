@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "login-page";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<section class="login-section">

    <div class="login-wrapper">

        <div class="card-login">

            <div class="form-container">

                <!-- LOGIN -->
                <form id="loginForm" class="active" method="post" asp-action="Login">

                    <h2>Bienvenido 👋</h2>

                    <div class="input-group">
                        <input type="text" name="username" required />
                        <label>Correo</label>
                    </div>

                    <div class="input-group">
                        <input type="password" name="password" required />
                        <label>Contraseña</label>
                    </div>

                    <button type="submit">Login</button>

                    <p class="forgot-password">
                        <a href="#" onclick="forgotPassword()">¿Olvidaste tu contraseña?</a>
                    </p>
                    <p class="switch-text">
                        ¿No tienes cuenta?
                        <span onclick="showSignup()">Crear cuenta</span>
                    </p>

                </form>

                <!-- SIGNUP -->
                <form id="signupForm" class="hidden" method="post" asp-action="Register">

                    <h2>Crear Cuenta 🚀</h2>

                    <div class="input-group">
                        <input type="text" name="name" required />
                        <label>Nombre Completo</label>
                    </div>

                    <div class="input-group">
                        <input type="email" name="email" required />
                        <label>Correo Electrónico</label>
                    </div>

                    <div class="input-group">
                        <input type="text" name="phone" required />
                        <label>Teléfono</label>
                    </div>

                    <div class="input-group">
                        <input type="text" name="address" required />
                        <label>Dirección</label>
                    </div>

                    <div class="input-group">
                        <input type="password" name="password" required />
                        <label>Contraseña</label>
                    </div>

                    <button type="submit">Registrarse</button>

                    <p class="switch-text">
                        ¿Ya tienes una cuenta?
                        <span onclick="showLogin()">Iniciar sesión</span>
                    </p>

                </form>

            </div>

        </div>

    </div>

</section>


<style>
    .login-section {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: transparent;
        position: relative;
        z-index: 0;
        overflow: visible;
    }

    .header {
        position: relative;
        z-index: 1000;
    }

    .login-page {
        background: url('https://images.unsplash.com/photo-1550547660-d9450f859349');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

        .login-page .header {
            background: transparent;
            box-shadow: none;
        }

            .login-page .header .logo,
            .login-page .header .navmenu a,
            .login-page .header .sitename {
                color: #fff;
            }

                .login-page .header .navmenu a:hover {
                    color: #ff4d4d;
                }

            .login-page .header .sitename {
                color: #ffffff;
                font-weight: bold;
            }

            .login-page .header .btn,
            .login-page .header .btn-getstarted {
                background: linear-gradient(45deg, #dc3545, #ff4d4d);
                color: white;
                border: none;
                border-radius: 30px;
                padding: 8px 20px;
                font-weight: 500;
                transition: all 0.3s ease;
            }

                .login-page .header .btn:hover,
                .login-page .header .btn-getstarted:hover {
                    background: linear-gradient(45deg, #b02a37, #dc3545);
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(220,53,69,0.4);
                }

    .card-login {
        background: rgba(255,255,255,0.80);
        padding: 40px;
        border-radius: 20px;
        width: 400px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    }

    .form-container {
        position: relative;
        min-height: 520px;
    }

        .form-container form {
            position: absolute;
            width: 100%;
            transition: all .4s ease;
        }

    .active {
        opacity: 1;
        transform: translateX(0);
        pointer-events: all;
    }

    .hidden {
        opacity: 0;
        transform: translateX(40px);
        pointer-events: none;
    }

    .input-group {
        position: relative;
        margin-bottom: 20px;
    }

        .input-group input {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            outline: none;
            background: #f1f1f1;
        }

        .input-group label {
            position: absolute;
            left: 12px;
            top: 12px;
            color: #888;
            transition: .3s;
        }

        .input-group input:focus + label,
        .input-group input:valid + label {
            top: -8px;
            left: 8px;
            font-size: 12px;
            color: #dc3545;
            background: white;
            padding: 0 5px;
        }

    button {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(45deg,#dc3545,#ff4d4d);
        color: white;
        font-weight: bold;
        transition: .3s;
    }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220,53,69,.4);
        }

    .switch-text {
        text-align: center;
        margin-top: 15px;
    }

        .switch-text span {
            color: #dc3545;
            font-weight: bold;
            cursor: pointer;
        }

    .forgot-password {
        text-align: center;
        margin-top: 15px;
    }

        .forgot-password a {
            color: #dc3545;
            font-weight: bold;
            text-decoration: none;
        }

            .forgot-password a:hover {
                text-decoration: underline;
            }

</style>
@if (TempData["ErrorLogin"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'error',
                title: 'Acceso denegado',
                text: '@TempData["ErrorLogin"]'
            });
        });
    </script>
}


<script>
    function showSignup() {
        document .getElementById("loginForm").classList.replace("active", "hidden");
        document .getElementById("signupForm").classList.replace("hidden", "active");
    }

    function showLogin() {
        document .getElementById("signupForm").classList.replace("active", "hidden");
        document .getElementById("loginForm").classList.replace("hidden", "active");
    }

    async function forgotPassword() {
        const

    {
        value: email
    }

    = await Swal.fire({
            title: 'Recuperar contraseña',
            input: 'email',
            inputLabel: 'Ingresa tu correo',
            inputPlaceholder: 'correo@ejemplo.com',
            confirmButtonText: 'Enviar solicitud',
            showCancelButton: true,
            cancelButtonText: 'Cancelar'
        });

    if (!email) return;

    fetch('/Auth/ForgotPassword', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                email: email
            })
        })
    .then(res => res.json())
    .then(data => {

                if (data.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Solicitud enviada',
                        html: `
                            Comunícate al número:<br>
                            <b>83675146</b><br><br>
                            Hemos notificado al administrador.
                        `
                    });

                } else {

                    Swal.fire({
                        icon: 'error',
                        title: 'Correo no encontrado'
                    });

                }

            });
    }

    async function cancelarPedido(id) {
        const result = await Swal.fire({
            title: '¿Cancelar pedido?',
            text: 'Esta acción no se puede deshacer',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ce1212',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, cancelar',
            cancelButtonText: 'No'
        });
        if (!result.isConfirmed) return;
        fetch('/Home/CancelarPedido', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ id: id })
        }) .then(res => res.json()) .then(data => {

                if (data.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Pedido cancelado',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });

                } else {

                    Swal.fire({
                        icon: 'error',
                        title: 'No se pudo cancelar',
                        text: data.mensaje || 'Error'
                    });
                }
            }) .catch(err => {
                console.error(err);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error al conectar con el servidor'
                });
            });
    }

    async function enviarReserva() {
        const reserva =

    {
        nombre: document.getElementById("nombre").value, telefono: document.getElementById("telefono").value, correo: document.getElementById("correo").value, personas: document.getElementById("personas").value, fecha: document.getElementById("fecha").value, hora: document.getElementById("hora").value, comentarios: document.getElementById("comentarios").value
    }

    ;

    const response = await fetch('/Home/EnviarReserva', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(reserva)
        });

    const data = await response.json();

    if (data.success) {
        Swal .fire({
                icon: 'success',
                title: 'Reserva enviada',
                text: 'Nos pondremos en contacto contigo'
            });
        document .getElementById("formReserva").reset();
    }

    else {
        Swal .fire({
                icon: 'error',
                title: 'Error',
                text: data.message
            });
    }

    }
</script>