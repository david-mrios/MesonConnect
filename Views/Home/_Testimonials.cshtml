@using Microsoft.AspNetCore.Http
@using MesonConnect.Models

@{
    var usuario = Context.Session.GetString("Usuario");
    var testimonios = ViewBag.Testimonios as List<Testimonio>;
}
<section id="testimonials" class="testimonials section light-background">

    <div class="container section-title position-relative text-center">

        <!-- Botón -->
        <button class="btn btn-primary d-none d-md-inline-block position-absolute top-0 end-0 mt-2 me-2"
                id="btnAddTestimonial">
            + Agregar Reseña
        </button>

        <!-- Título -->
        <h2>TESTIMONIOS</h2>
        <p>Lo que dicen nuestros <span class="description-title">clientes</span></p>

        <!-- Botón mobile -->
        <div class="d-md-none mt-3">
            <button class="btn btn-primary" id="btnAddTestimonialMobile">
                + Agregar Reseña
            </button>
        </div>

    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="swiper testimonial-swiper">

            <div class="swiper-wrapper">

                    @if (testimonios != null && testimonios.Any())
                    {
                        @foreach (var item in testimonios)
                        {
                            <div class="swiper-slide">

                                <div class="testimonial-item">

                                    <div class="row gy-4 justify-content-center">

                                        <div class="col-lg-6">

                                            <div class="testimonial-content">

                                                <p>
                                                    <i class="bi bi-quote quote-icon-left"></i>

                                                    <span>@item.Mensaje</span>

                                                    <i class="bi bi-quote quote-icon-right"></i>
                                                </p>

                                                <h3>@item.Cliente.nombre</h3>
                                                <h4>Cliente</h4>
                                                <div class="mb-2">
                                                    @for (int i = 1; i <= item.Calificacion; i++)
                                                    {
                                                        <span style="color:gold;font-size:20px;">⭐</span>
                                                    }
                                                </div>

                                                

                                            </div>

                                        </div>

                                    <div class="col-lg-2 text-center">

                                        <div class="user-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>

                                    </div>
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="swiper-slide">

                            <div class="testimonial-item">

                                <div class="row gy-4 justify-content-center">

                                    <div class="col-lg-6">

                                        <div class="testimonial-content">

                                            <p>
                                                <span>
                                                    Aún no hay testimonios disponibles.
                                                </span>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            <!-- Paginación -->
            <div class="swiper-pagination"></div>

        </div>

    </div>

</section>


<!-- MODAL -->
<!-- MODAL -->
<div id="testimonialModal" class="modal-testimonial">

    <div class="modal-content">

        <div class="modal-header">
            <h4>Agregar Reseña</h4>
            <button type="button" onclick="closeModal()">✖</button>
        </div>

        <p>
            <strong>Usuario:</strong> @usuario
        </p>

        <div class="mb-3">

            <label class="form-label">
                Calificación
            </label>

            <div class="rating">

                <span onclick="setRating(1)">⭐</span>
                <span onclick="setRating(2)">⭐</span>
                <span onclick="setRating(3)">⭐</span>
                <span onclick="setRating(4)">⭐</span>
                <span onclick="setRating(5)">⭐</span>

            </div>

            <input type="hidden"
                   id="rating"
                   value="0" />

        </div>

        <textarea id="message"
                  placeholder="Cuéntanos tu experiencia..."
                  class="form-control mb-2"></textarea>

        <button class="btn btn-success w-100"
                onclick="saveTestimonial()">
            Guardar
        </button>

    </div>

</div>

<style>
    /* ===== MODAL FONDO ===== */
    .modal-testimonial {
        display: none;
        position: fixed;
        z-index: 99999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
    }

    /* ===== CONTENIDO ===== */
    .modal-content {
        background: white;
        width: 90%;
        max-width: 400px;
        margin: 10% auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        animation: fadeIn 0.3s ease;
    }

    /* HEADER */
    .modal-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
    }

        .modal-header h4 {
            margin: 0;
        }

        .modal-header button {
            border: none;
            background: none;
            font-size: 18px;
            cursor: pointer;
        }

    /* INPUTS */
    .modal-content input,
    .modal-content textarea {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #ddd;
        margin-bottom: 10px;
    }

    /* BOTÓN */
    .modal-content .btn-success {
        background: #ff6600;
        border: none;
    }

        .modal-content .btn-success:hover {
            background: #e65c00;
        }

    .rating {
        font-size: 35px;
        text-align: center;
        margin-bottom: 15px;
    }

        .rating span {
            cursor: pointer;
            opacity: .3;
            transition: .2s;
        }

            .rating span.active {
                opacity: 1;
            }

    /* ANIMACIÓN */
    @@keyframes zoomIn {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .user-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #f1f1f1;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
    }

        .user-avatar i {
            font-size: 55px;
            color: #666;
        }
</style>

<script>

    const usuarioLogueado = '@usuario';

    const isAuthenticated =
        usuarioLogueado !== null &&
        usuarioLogueado !== '';

    document.getElementById("btnAddTestimonial")
        ?.addEventListener("click", openModal);

    document.getElementById("btnAddTestimonialMobile")
        ?.addEventListener("click", openModal);

    function openModal() {

        if (!isAuthenticated) {

            window.location.href =
                '/Auth/Login';

            return;
        }

        document.getElementById("testimonialModal")
            .style.display = "block";
    }

    function closeModal() {

        document.getElementById("testimonialModal")
            .style.display = "none";
    }

    function setRating(value) {

        document.getElementById("rating").value = value;

        const stars =
            document.querySelectorAll(".rating span");

        stars.forEach((star, index) => {

            if (index < value) {
                star.classList.add("active");
            }
            else {
                star.classList.remove("active");
            }

        });
    }

    function saveTestimonial() {

        let message =
            document.getElementById("message")
                .value.trim();

        let calificacion =
            document.getElementById("rating")
                .value;

        if (!message) {

            alert("Escribe un comentario");
            return;
        }

        if (calificacion == 0) {

            alert("Selecciona una calificación");
            return;
        }

        fetch('/Home/GuardarTestimonio', {

            method: 'POST',

            headers: {
                'Content-Type':
                    'application/x-www-form-urlencoded'
            },

            body:
                'mensaje=' +
                encodeURIComponent(message)
                +
                '&calificacion=' +
                calificacion

        })
        .then(response => response.json())
        .then(data => {

            if (data.success) {

                alert("Testimonio enviado correctamente");

                location.reload();
            }
            else {

                alert("Debes iniciar sesión");

                window.location =
                    '/Auth/Login';
            }

        });
    }

    window.onclick = function (event) {

        const modal =
            document.getElementById("testimonialModal");

        if (event.target === modal) {

            closeModal();
        }
    };


        document.addEventListener("DOMContentLoaded", function () {

        new Swiper(".testimonial-swiper", {
            loop: true,
            speed: 600,

            autoplay: {
                delay: 3000,
                disableOnInteraction: false
            },

            pagination: {
                el: ".swiper-pagination",
                clickable: true
            },

            slidesPerView: 1,
            spaceBetween: 20
        });

    });

</script>