    @using Microsoft.AspNetCore.Http
    @using MesonConnect.Models

    @{
        var usuario = Context.Session.GetString("Usuario");
        var pedidos = ViewBag.Pedidos as List<Pedido>;
    }

    <section id="contact" class="contact section">

        <div class="container section-title">
            <h2>Mi Cuenta</h2>
            <p>
                <span>Información de</span>
                <span class="description-title">Mi Perfil</span>
            </p>
        </div>

        <div class="container">

            <div class="mb-5">
                <iframe style="width:100%; height:400px;"
                        src="https://maps.google.com/maps?q=12.13934298145189,-86.21092625608138&z=18&output=embed"
                        frameborder="0"
                        allowfullscreen>
                </iframe>
            </div>

            <div class="row gy-4">

                <!-- PERFIL -->
                <div class="col-lg-4">

                    <div class="card shadow-lg border-0 p-4 text-center">

                        <img src="/assets/img/testimonials/testimonials-1.jpg"
                             class="rounded-circle mx-auto mb-3"
                             width="120"
                             height="120"
                             style="object-fit:cover;">

                        @if (!string.IsNullOrEmpty(usuario))
                        {
                            <h3>@usuario</h3>

                            <p class="text-muted">
                                Cliente Registrado
                            </p>

                            <hr>

                            <div class="text-start">

                                <p>
                                    <strong>Estado:</strong> Sesión Activa
                                </p>

                                <p>
                                    <strong>Cuenta:</strong> Cliente
                                </p>

                            </div>
                        }
                        else
                        {
                            <h3>No has iniciado sesión</h3>

                            <p class="text-muted">
                                Inicia sesión para ver tu perfil.
                            </p>

                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="btn btn-danger mt-3">
                                Iniciar Sesión
                            </a>
                        }

                    </div>

                </div>

                <!-- PEDIDOS -->
                <div class="col-lg-8">

                    <div class="card shadow-lg border-0">

                        <div class="card-header bg-dark">
                            <h4 class="mb-0 text-white">
                                Historial de Pedidos
                            </h4>
                        </div>

                        <div class="card-body">

                            <div class="table-responsive pedidos-scroll">
                                <table class="table table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th># Pedido</th>
                                            <th>Fecha</th>
                                            <th>Total</th>
                                            <th>Estado</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @if (!string.IsNullOrEmpty(usuario) && pedidos != null && pedidos.Any())
                                        {
                                            @foreach (var pedido in pedidos)
                                            {
                                                <tr>

                                                    <td>@pedido.id</td>

                                                    <td>@pedido.fecha_pedido.ToString("dd/MM/yyyy")</td>

                                                    <td>C$ @pedido.total</td>

                                                    <td>

                                                        @if (pedido.Estado == "Pendiente")
                                                        {
                                                            <span class="badge bg-warning text-dark">
                                                                Pendiente
                                                            </span>
                                                        }
                                                        else if (pedido.Estado == "Preparando")
                                                        {
                                                            <span class="badge bg-primary">
                                                                Preparando
                                                            </span>
                                                        }
                                                        else if (pedido.Estado == "Entregado")
                                                        {
                                                            <span class="badge bg-success">
                                                                Entregado
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">
                                                                Cancelado
                                                            </span>
                                                        }

                                                    </td>

                                                    <td>

                                                        @if (pedido.Estado == "Pendiente")
                                                        {
                                                            <button class="btn btn-danger btn-sm"
                                                                    onclick="cancelarPedido(@pedido.id)">
                                                                Cancelar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-secondary btn-sm"
                                                                    disabled>
                                                                Finalizado
                                                            </button>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center">
                                                    No hay pedidos registrados
                                                </td>
                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <style>

        .pedidos-scroll tbody {
            display: block;
            max-height: 250px;
            overflow-y: auto;
        }

            .pedidos-scroll thead,
            .pedidos-scroll tbody tr {
                display: table;
                width: 100%;
                table-layout: fixed;
            }

        .card {
            border-radius: 15px;
        }

        .table th {
            font-weight: 600;
        }

        .badge {
            font-size: 14px;
            padding: 8px 12px;
        }

    </style>

<script>
    async function cancelarPedido(id) {

        const result = await Swal.fire({
            title: '¿Cancelar pedido?',
            text: 'Esta acción no se puede deshacer',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ce1212',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, cancelar',
            cancelButtonText: 'No'
        });

        if (!result.isConfirmed) return;

        fetch('/Home/CancelarPedido', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ id: id })
        })
        .then(res => res.json())
        .then(data => {

            if (data.success) {

                Swal.fire({
                    icon: 'success',
                    title: 'Pedido cancelado',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });

            } else {

                Swal.fire({
                    icon: 'error',
                    title: 'No se pudo cancelar',
                    text: data.mensaje || 'Error'
                });
            }
        })
        .catch(err => {
            console.error(err);

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error al conectar con el servidor'
            });
        });
    }
</script>