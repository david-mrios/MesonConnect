    @using Microsoft.AspNetCore.Http
    @using MesonConnect.Models

    @{
        var usuario = Context.Session.GetString("Usuario");
        var pedidos = ViewBag.Pedidos as List<Pedido>;

    }

    <section id="contact" class="contact section">


    <!-- RESERVAS -->

        <div class="container section-title" data-aos="fade-up">
            <h2>Reservaciones</h2>
            <p>
                <span>Almorzá/Cená</span>
            <span class="description-title">con Nosotros</span>
            </p>
        </div>

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row g-4">

                <div class="col-lg-4">

                    <div class="reservation-info">

                        <h3>Información</h3>

                        <p>
                            Complete el formulario y nuestro equipo confirmará
                            la disponibilidad de su mesa.
                        </p>

                        <div class="info-item">
                            <strong>📍 Dirección</strong>
                            <p>
                                semaforos de donde fue el hosp. velez paiz 1c al sur, 80 vrs. abajo M/i, Managua, Nicaragua, Ciudad Sandino, Nicaragua
                            </p>
                        </div>


                    <div class="info-item">
    <strong>
        <i class="bi bi-whatsapp" style="color:#25D366;"></i>
        WhatsApp
    </strong>

    <p>
        <a href="https://wa.me/50583675146?text=Hola,%20quiero%20hacer%20una%20reserva"
           target="_blank"
           style="color:#25D366;text-decoration:none;font-weight:600;">
            +505 8367-5146
        </a>
    </p>
</div>

<div class="info-item">

    <strong>🌐 Síguenos</strong>

    <div class="social-links mt-3">

        <a href="https://www.facebook.com/share/1BTeBVLpuk/"
           target="_blank"
           class="social-btn facebook">
            <i class="bi bi-facebook"></i>
            Facebook
        </a>

        <a href="https://www.instagram.com/mesondelatia"
           target="_blank"
           class="social-btn instagram">
            <i class="bi bi-instagram"></i>
            Instagram
        </a>

    </div>

</div>    

                        <div class="info-item">
                            <strong>🕒 Horario</strong>
                            <p>11:00 AM - 10:00 PM</p>
                        </div>

                    </div>

                </div>

                <div class="col-lg-8">

                <form id="formReserva">

                        <div class="row">

                            <div class="col-md-6 mb-3">
                            <input type="text"
                                   id="nombre"
                                   class="form-control"
                                   placeholder="Nombre Completo">
                            </div>

                            <div class="col-md-6 mb-3">
                            <input type="tel"
                                   id="telefono"
                                   class="form-control"
                                   placeholder="Teléfono">
                            </div>
                            
                            <div class="col-md-6 mb-3">
                            <input type="email"
                                   id="correo"
                                   class="form-control"
                                   placeholder="Correo Electrónico">
                            </div>

                            <div class="col-md-6 mb-3">
                            <select id="personas" class="form-select">
                                <option value="" selected disabled>
                                    Cantidad de Personas
                                </option>
                                <option>1 Persona</option>
                                <option>2 Personas</option>
                                <option>3 Personas</option>
                                <option>4 Personas</option>
                                <option>5 Personas</option>
                                <option>6 Personas</option>
                                <option>Más de 6 Personas</option>
                            </select>
                            </div>

                            <div class="col-md-6 mb-3">
                            <input type="date"
                                   id="fecha"
                                   class="form-control">
                            </div>

                            <div class="col-md-6 mb-3">
                            <input type="time"
                                   id="hora"
                                   class="form-control">
                            </div>

                        </div>

                        <div class="mb-3">
                        <textarea id="comentarios"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Comentarios adicionales"></textarea>
                        </div>

                        <div class="text-center">
                        <button type="button"
                                class="btn-reserva-form"
                                onclick="enviarReserva()">
                            Solicitar Reserva
                        </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    




        <div class="container section-title">
            <h2>Mi Cuenta</h2>
            <p>
                <span>Información de</span>
                <span class="description-title">Mi Perfil</span>
            </p>
        </div>

        <div class="container">

            <div class="mb-5">
                <iframe style="width:100%; height:400px;"
                        src="https://maps.google.com/maps?q=12.13934298145189,-86.21092625608138&z=18&output=embed"
                        frameborder="0"
                        allowfullscreen>
                </iframe>
            </div>

            <div class="row gy-4">

                <!-- PERFIL -->
                <div class="col-lg-4">

                    <div class="card shadow-lg border-0 p-4 text-center">
                    <div class="text-center mb-3">
                        <i class="bi bi-person-circle"
                           style="font-size:120px;color:#6c757d;"></i>
                    </div>

                        @if (!string.IsNullOrEmpty(usuario))
                        {
                            <h3>@usuario</h3>

                            <p class="text-muted">
                                Cliente Registrado
                            </p>

                            <hr>

                            <div class="text-start">

                                <p>
                                    <strong>Estado:</strong> Sesión Activa
                                </p>

                                <p>
                                    <strong>Cuenta:</strong> Cliente
                                </p>

                            </div>
                        }
                        else
                        {
                            <h3>No has iniciado sesión</h3>

                            <p class="text-muted">
                                Inicia sesión para ver tu perfil.
                            </p>

                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="btn btn-danger mt-3">
                                Iniciar Sesión
                            </a>
                        }

                    </div>

                </div>

                <!-- PEDIDOS -->
                <div class="col-lg-8">

                    <div class="card shadow-lg border-0">

                        <div class="card-header bg-dark">
                            <h4 class="mb-0 text-white">
                                Historial de Pedidos
                            </h4>
                        </div>

                        <div class="card-body">

                            <div class="table-responsive pedidos-scroll">
                                <table class="table table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th># Pedido</th>
                                            <th>Fecha</th>
                                            <th>Total</th>
                                            <th>Estado</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @if (!string.IsNullOrEmpty(usuario) && pedidos != null && pedidos.Any())
                                        {
                                            @foreach (var pedido in pedidos)
                                            {
                                                <tr>

                                                    <td>@pedido.id</td>

                                                    <td>@pedido.fecha_pedido.ToString("dd/MM/yyyy")</td>

                                                    <td>C$ @pedido.total</td>

                                                    <td>

                                                        @if (pedido.Estado == "Pendiente")
                                                        {
                                                            <span class="badge bg-warning text-dark">
                                                                Pendiente
                                                            </span>
                                                        }
                                                        else if (pedido.Estado == "Preparando")
                                                        {
                                                            <span class="badge bg-primary">
                                                                Preparando
                                                            </span>
                                                        }
                                                        else if (pedido.Estado == "Entregado")
                                                        {
                                                            <span class="badge bg-success">
                                                                Entregado
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">
                                                                Cancelado
                                                            </span>
                                                        }

                                                    </td>

                                                    <td>

                                                        @if (pedido.Estado == "Pendiente")
                                                        {
                                                            <button class="btn btn-danger btn-sm"
                                                                    onclick="cancelarPedido(@pedido.id)">
                                                                Cancelar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-secondary btn-sm"
                                                                    disabled>
                                                                Finalizado
                                                            </button>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center">
                                                    No hay pedidos registrados
                                                </td>
                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

</section>



