@using MesonConnect.Models

@{
    var promociones = ViewBag.Promociones as List<Promocion>;
}

<section id="events" class="events section">

    <div class="container-fluid">

        <div class="swiper init-swiper">

            <script type="application/json" class="swiper-config">
                {
                  "loop": true,
                  "loopAdditionalSlides": 10,
                  "watchOverflow": false,
                  "speed": 1000,
                  "autoplay": {
                    "delay": 1500,
                    "disableOnInteraction": false
                  },
                  "slidesPerView": 3,
                  "spaceBetween": 20,
                  "centeredSlides": false,
                  "pagination": {
                    "el": ".swiper-pagination",
                    "clickable": true
                  },
                  "breakpoints": {
                    "320": {
                      "slidesPerView": 1,
                      "spaceBetween": 10
                    },
                    "768": {
                      "slidesPerView": 2,
                      "spaceBetween": 20
                    },
                    "1200": {
                      "slidesPerView": 3,
                      "spaceBetween": 20
                    }
                  }
                }
            </script>

            <div class="swiper-wrapper">

                @if (promociones != null && promociones.Any())
                {
                    var imagenes = new[]
                    {
                                "/assets/img/events-1.jpg",
                                "/assets/img/events-2.jpg",
                                "/assets/img/events-3.jpg",
                                "/assets/img/events-4.jpg"
                                };

                    int i = 0;

                    @foreach (var promo in promociones)
                    {
                        <div class="swiper-slide event-item"
                             style="background-image:url('@imagenes[i % imagenes.Length]')">

                            <h3>@promo.Titulo</h3>

                            <p class="promo-description">
                                @promo.Descripcion
                            </p>

                            <div class="promo-badge">
                                @promo.Descuento% OFF
                            </div>

                        </div>

                        i++;
                    }
                }
                else
                {
                    <div class="swiper-slide event-item"
                         style="background-image:url('/assets/img/events-1.jpg')">

                        <h3>No hay promociones disponibles</h3>

                    </div>
                }

            </div>

            <div class="swiper-pagination"></div>

        </div>

    </div>

</section>

<style>

    .events .swiper {
        overflow: hidden;
    }

    .events .swiper-slide {
        height: auto;
    }

    .event-item {
        height: 320px;
        color: white;
        padding: 25px;
        border-radius: 15px;
        background-size: cover;
        background-position: center;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

        .event-item::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.45);
        }

        .event-item h3,
        .event-item p,
        .event-item .promo-badge {
            position: relative;
            z-index: 2;
        }

        .event-item h3 {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 10px;
        }

    .promo-description {
        font-size: 15px;
        margin-bottom: 10px;
    }

    .promo-badge {
        background: #ff6600;
        color: white;
        padding: 8px 14px;
        border-radius: 8px;
        display: inline-block;
        width: fit-content;
        font-weight: bold;
        font-size: 18px;
    }

</style>