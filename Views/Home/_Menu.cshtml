    @model List<MesonConnect.Models.Platillo>

    <style>
        .menu-img {
            width: 100%;
            height: 220px; /* todas del mismo tamaño */
            object-fit: cover; /* recorte sin deformar */
            border-radius: 12px; /* opcional estilo moderno */
        }
    </style>

    @{
        var postresImgs = new[]
        {
            "/assets/img/menu/Postres/TartaCrema.webp",
            "/assets/img/menu/Postres/TartaCanela.jpg",
            "/assets/img/menu/Postres/TartaCaramelizada.webp",
            "/assets/img/menu/Postres/TartaCasera.jpg",
            "/assets/img/menu/Postres/TartaHelado.webp"
        };

        var bebidasImgs = new[]
        {
            "https://images.unsplash.com/photo-1551024709-8f23befc6f87",
            "https://images.unsplash.com/photo-1544145945-f90425340c7e",
            "https://images.unsplash.com/photo-1525385133512-2f3bdd039054",
            "https://images.unsplash.com/photo-1514361892635-cebb6c0e4c1c",
            "https://images.unsplash.com/photo-1604908812216-1c0c3c2b2c5a"
        };

        var platosImgs = new[]
        {
            "/assets/img/menu/PlatoFuerte/cesar.jpg",
            "/assets/img/menu/PlatoFuerte/parrilla.jpg",
            "/assets/img/menu/PlatoFuerte/pasta.webp",
            "/assets/img/menu/PlatoFuerte/Margherita.jpg",
            "/assets/img/menu/PlatoFuerte/Hamburguesa.jpg"

        };

        var entradasImgs = new[]
        {
            "/assets/img/menu/entradas/Tacos al pastor.jpg", 
            "/assets/img/menu/entradas/Guacamole con totopos.jpg",
            "/assets/img/menu/entradas/sopa de mariscos.jpg", 
            "/assets/img/menu/entradas/sushi.jpg",
            "/assets/img/menu/entradas/Ceviche.jpg"       
        };
    }

    <section id="menu" class="menu section">

        <div class="container section-title">
            <h2>Menú</h2>
            <p><span>Descubre nuestro</span> <span class="description-title">Menú Rápido</span></p>
        </div>

        <div class="container">

            <ul class="nav nav-tabs d-flex justify-content-center">

                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#menu-starters">
                        <h4>Postres</h4>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#menu-breakfast">
                        <h4>Bebidas</h4>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#menu-lunch">
                        <h4>Platos Fuertes</h4>
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#menu-dinner">
                        <h4>Entradas</h4>
                    </button>
                </li>

            </ul>

            <div class="tab-content">

                <!-- POSTRES -->
                <div class="tab-pane fade show active" id="menu-starters">

                    <div class="tab-header text-center">
                        <p>Menú</p>
                        <h3>Postres</h3>
                    </div>

                    <div class="row gy-5">

                        @{
                            var postres = Model?.Where(x => x.Categoria == "Postres").Take(5).ToList()
                            ?? new List<MesonConnect.Models.Platillo>();
                        }

                        @for (int i = 0; i < postres.Count; i++)
                        {
                            var item = postres[i];

                            <div class="col-lg-4 menu-item">

                                <img src="@postresImgs[i % postresImgs.Length]"
                                     class="menu-img img-fluid"
                                     alt="@item.Nombre" />

                                <h4>@item.Nombre</h4>
                                <p class="ingredients">@item.Descripcion</p>
                                <p class="price">C$ @item.Precio</p>

                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">

                                <button type="button"
                                        class="btn btn-outline-secondary qty-minus">
                                    -
                                </button>

                                <input type="number"
                                       class="form-control qty-input"
                                       value="1"
                                       min="1"
                                       style="width:60px;text-align:center;" />

                                <button type="button"
                                        class="btn btn-outline-secondary qty-plus">
                                    +
                                </button>

                            </div>

                            <button class="add-to-cart"
                                    data-id="@item.Id"
                                    data-name="@item.Nombre"
                                    data-price="@item.Precio">
                                <i class="bi bi-cart-plus"></i> Agregar
                            </button>

                        </div>
                        }

                    </div>
                </div>

                <!-- BEBIDAS -->
                <div class="tab-pane fade" id="menu-breakfast">

                    <div class="tab-header text-center">
                        <p>Menú</p>
                        <h3>Bebidas</h3>
                    </div>

                    <div class="row gy-5">

                        @{
                            var bebidas = Model?.Where(x => x.Categoria == "Bebidas").Take(5).ToList()
                            ?? new List<MesonConnect.Models.Platillo>();
                        }

                        @for (int i = 0; i < bebidas.Count; i++)
                        {
                            var item = bebidas[i];

                            <div class="col-lg-4 menu-item">

                                <img src="@bebidasImgs[i % bebidasImgs.Length]"
                                     class="menu-img img-fluid"
                                     alt="@item.Nombre" />

                                <h4>@item.Nombre</h4>
                                <p class="ingredients">@item.Descripcion</p>
                                <p class="price">C$ @item.Precio</p>

                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">

                                <button type="button"
                                        class="btn btn-outline-secondary qty-minus">
                                    -
                                </button>

                                <input type="number"
                                       class="form-control qty-input"
                                       value="1"
                                       min="1"
                                       style="width:60px;text-align:center;" />

                                <button type="button"
                                        class="btn btn-outline-secondary qty-plus">
                                    +
                                </button>

                            </div>

                            <button class="add-to-cart"
                                    data-id="@item.Id"
                                    data-name="@item.Nombre"
                                    data-price="@item.Precio">
                                <i class="bi bi-cart-plus"></i> Agregar
                            </button>

                            </div>
                        }

                    </div>
                </div>

                <!-- PLATOS FUERTES -->
                <div class="tab-pane fade" id="menu-lunch">

                    <div class="tab-header text-center">
                        <p>Menú</p>
                        <h3>Platos Fuertes</h3>
                    </div>

                    <div class="row gy-5">

                        @{
                            var platos = Model?.Where(x => x.Categoria == "Platos Fuertes").Take(5).ToList()
                            ?? new List<MesonConnect.Models.Platillo>();
                        }

                        @for (int i = 0; i < platos.Count; i++)
                        {
                            var item = platos[i];

                            <div class="col-lg-4 menu-item">

                                <img src="@platosImgs[i % platosImgs.Length]"
                                     class="menu-img img-fluid"
                                     alt="@item.Nombre" />

                                <h4>@item.Nombre</h4>
                                <p class="ingredients">@item.Descripcion</p>
                                <p class="price">C$ @item.Precio</p>

                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">

                                <button type="button"
                                        class="btn btn-outline-secondary qty-minus">
                                    -
                                </button>

                                <input type="number"
                                       class="form-control qty-input"
                                       value="1"
                                       min="1"
                                       style="width:60px;text-align:center;" />

                                <button type="button"
                                        class="btn btn-outline-secondary qty-plus">
                                    +
                                </button>

                            </div>

                            <button class="add-to-cart"
                                    data-id="@item.Id"
                                    data-name="@item.Nombre"
                                    data-price="@item.Precio">
                                <i class="bi bi-cart-plus"></i> Agregar
                            </button>

                            </div>
                        }

                    </div>
                </div>

                <!-- ENTRADAS -->
                <div class="tab-pane fade" id="menu-dinner">

                    <div class="tab-header text-center">
                        <p>Menú</p>
                        <h3>Entradas</h3>
                    </div>

                    <div class="row gy-5">

                        @{
                            var entradas = Model?.Where(x => x.Categoria == "Entradas").Take(5).ToList()
                            ?? new List<MesonConnect.Models.Platillo>();
                        }

                        @for (int i = 0; i < entradas.Count; i++)
                        {
                            var item = entradas[i];

                            <div class="col-lg-4 menu-item">

                                <img src="@entradasImgs[i % entradasImgs.Length]"
                                     class="menu-img img-fluid"
                                     alt="@item.Nombre" />

                                <h4>@item.Nombre</h4>
                                <p class="ingredients">@item.Descripcion</p>
                                <p class="price">C$ @item.Precio</p>

                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">

                                <button type="button"
                                        class="btn btn-outline-secondary qty-minus">
                                    -
                                </button>

                                <input type="number"
                                       class="form-control qty-input"
                                       value="1"
                                       min="1"
                                       style="width:60px;text-align:center;" />

                                <button type="button"
                                        class="btn btn-outline-secondary qty-plus">
                                    +
                                </button>

                            </div>

                            <button class="add-to-cart"
                                    data-id="@item.Id"
                                    data-name="@item.Nombre"
                                    data-price="@item.Precio">
                                <i class="bi bi-cart-plus"></i> Agregar
                            </button>

                            </div>
                        }

                    </div>
                </div>

            </div>

        </div>

    </section>

    <style>

    .qty-input {
        width: 60px !important;
        text-align: center;
        font-weight: bold;
        border-radius: 10px;
    }

    .qty-plus,
    .qty-minus {
        width: 38px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        font-weight: bold;
    }

	    .menu-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 12px;
        }

    .add-to-cart {
        background: #ff6b35;
        border: none;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        margin-top: 8px;
        transition: all .25s ease;
    }

        .add-to-cart:hover {
            background: #e85d2a;
            color: white;
            transform: translateY(-1px);
        }

        .add-to-cart:active {
            transform: scale(0.98);
        }
    </style>